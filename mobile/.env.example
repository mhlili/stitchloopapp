# Copy to .env and fill in. Restart Expo (npx expo start -c) after editing.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app, so never put secrets here.

# Where the app sends API requests. Use the Railway API domain, or your laptop's
# LAN IP while running the API locally. Never localhost: in Expo Go that's the phone.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Cloudinary (photos upload straight from the phone). Cloud name is on the dashboard;
# create the preset under Settings > Upload > Upload presets, with signing mode "Unsigned".
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
